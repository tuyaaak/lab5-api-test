{
  "info": {
    "name": "Лаб 5 - Бүртгэлийн API тест",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Бие даасан setup + POST oracle-ууд; server.js эх кодоор тогтоосон."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "T01 — Амжилттай бүртгэл",
      "item": [
        {
          "name": "Setup оюутан",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/students/S01",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students",
                "S01"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"status\": \"active\", \"coursesTaken\": [\"CS201\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"result = OK\", function () { pm.expect(pm.response.json().result).to.eql(\"OK\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup хичээл",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses/C01",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses",
                "C01"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"prerequisites\": [\"CS201\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"result = OK\", function () { pm.expect(pm.response.json().result).to.eql(\"OK\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Амжилттай бүртгэл",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "registrations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"studentID\": \"S01\", \"courseID\": \"C01\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status 200 (зориуд буруу)\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"result = OK\", function () { pm.expect(pm.response.json().result).to.eql(\"OK\"); });",
                  "pm.test(\"registrationID тоо\", function () { pm.expect(pm.response.json().registrationID).to.be.a(\"number\"); });"
                ]
